---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SEO from '../components/SEO.astro';
import { SITE } from '../data/site.config';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  ogImage?: string;
  noindex?: boolean;
}

const {
  title,
  description = SITE.description,
  type = 'website',
  publishedTime,
  tags = [],
  ogImage,
  noindex = false,
} = Astro.props;

const pageTitle = title ? `${title} · ${SITE.title}` : `${SITE.title} — ${SITE.tagline}`;
---

<!doctype html>
<html lang={SITE.lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={pageTitle}
      description={description}
      type={type}
      publishedTime={publishedTime}
      tags={tags}
      ogImage={ogImage}
      noindex={noindex}
    />
    <script is:inline>
      // 在首次绘制前设定主题，避免暗色模式下闪白
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
          document.documentElement.dataset.theme = theme;
          document.documentElement.dataset.themePref = stored || 'auto';
        } catch (e) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主内容</a>
    <div class="reading-progress" aria-hidden="true"></div>
    <Header />
    <main id="main">
      <div class="container">
        <slot />
      </div>
    </main>
    <Footer />
    <script>
      // 阅读进度条：在文章详情页（存在 .prose）才计算并更新宽度
      const bar = document.querySelector('.reading-progress') as HTMLElement | null;
      if (bar) {
        const update = () => {
          // 文章正文范围：从 .prose 顶部到底部；找不到则用整页
          const scope = (document.querySelector('.prose') ?? document.body) as HTMLElement;
          const start = scope.getBoundingClientRect().top + window.scrollY;
          const height = scope.offsetHeight;
          const scrolled = window.scrollY - start;
          const ratio = height > 0 ? scrolled / (height - window.innerHeight * 0.4) : 0;
          bar.style.width = Math.max(0, Math.min(100, ratio * 100)) + '%';
        };
        update();
        document.addEventListener('scroll', update, { passive: true });
        // 与 View Transitions 兼容
        document.addEventListener('astro:page-load', update);
      }
    </script>
  </body>
</html>
