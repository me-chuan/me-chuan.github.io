---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE } from '../data/site.config';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const featured = projects.filter((p) => p.data.featured);
const latestPosts = posts.slice(0, 4);
const latestProjects = (featured.length > 0 ? featured : projects).slice(0, 4);

const dateFmt = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout>
  <section class="hero">
    <div class="hero__inner">
      <img class="hero__avatar" src={SITE.avatar} alt={`${SITE.author} 的头像`} width="88" height="88" />
      <div class="hero__body">
        <h1 class="hero__name">{SITE.author}</h1>
        <p class="hero__tagline">{SITE.tagline}</p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/blog/">读文章</a>
          <a class="btn" href="/projects/">看项目</a>
          {
            SITE.links.github && (
              <a class="btn" href={SITE.links.github} target="_blank" rel="me noopener noreferrer">
                GitHub
              </a>
            )
          }
        </div>
      </div>
    </div>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>最新文章</h2>
          <a href="/blog/">完整目录 →</a>
        </div>
        <ol class="post-list-numbered">
          {latestPosts.map((post, i) => (
            <li>
              <span class="post-list-number">
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="post-list-main">
                <h3 class="post-list-title">
                  <a href={`/blog/${post.id}/`}>{post.data.title}</a>
                </h3>
                <p class="post-list-desc">{post.data.description}</p>
                <div class="post-list-meta">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {dateFmt.format(post.data.pubDate)}
                  </time>
                  {post.data.tags.slice(0, 2).map((tag) => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    latestProjects.length > 0 && (
      <section class="section">
        <div class="section-head">
          <h2>项目</h2>
          <a href="/projects/">全部项目 →</a>
        </div>
        <div class="card-grid">
          {latestProjects.map((project) => (
            <ProjectCard project={project} />
          ))}
        </div>
      </section>
    )
  }
</BaseLayout>
