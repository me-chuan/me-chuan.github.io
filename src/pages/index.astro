---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import RetroWindow from '../components/RetroWindow.astro';
import { SITE } from '../data/site.config';
import workstation from '../assets/retro-workstation.webp';

const posts = (await getCollection('blog', ({ id, data }) => !data.draft && id !== 'content-authoring-guide'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 2);
const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => a.data.order - b.data.order);
const project = projects.find(({ data }) => data.featured) ?? projects[0];
const entries = [
  ...(project ? [{
    title: project.data.title,
    description: project.data.description,
    href: `/projects/${project.id}/`,
    type: '项目',
    tags: project.data.tech,
    icon: '>_',
  }] : []),
  ...posts.map(({ id, data }, index) => ({
    title: data.title,
    description: data.description,
    href: `/blog/${id}/`,
    type: '笔记',
    tags: data.tags,
    icon: index === 0 ? '↗' : '</>',
  })),
];
---

<BaseLayout>
  <section class="retro-hero" aria-labelledby="home-intro">
    <div class="retro-hero__copy">
      <h1 id="home-intro" lang="en">Research &amp; Dev<br /><span>Portfolio</span></h1>
      <p>你好，我是 {SITE.author}。我在这里记录<mark>语音与大模型</mark>的学习笔记，以及<mark>软件工程</mark>里的项目实践。</p>
      <div class="retro-hero__actions">
        <a class="retro-button retro-button--start" href="/projects/"><span aria-hidden="true">▶</span> 查看项目</a>
        <a class="retro-button retro-button--ghost" href={SITE.links.github}>GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
    <div class="retro-hero__art">
      <div class="retro-sunset" aria-hidden="true"><i></i><b></b></div>
      <span class="retro-hero__spark retro-hero__spark--left" aria-hidden="true">✦</span>
      <span class="retro-hero__spark retro-hero__spark--right" aria-hidden="true">✧</span>
      <img src={workstation.src} width={workstation.width} height={workstation.height} alt="像素风的 CRT 电脑显示着音频波形，旁边蜷着一只橘猫" fetchpriority="high" />
    </div>
  </section>

  {entries.length > 0 && (
    <RetroWindow id="selected-work" title="精选项目与笔记" icon="▣">
      <ul class="retro-library">
        {entries.map((entry) => (
          <li class="retro-tile">
            <span class="retro-tile__icon" aria-hidden="true">{entry.icon}</span>
            <div class="retro-tile__content">
              <h3><a href={entry.href}>{entry.title}</a></h3>
              <ul class="tag-list retro-tile__tags" aria-label="分类">
                <li><span class="tag">{entry.type}</span></li>
                {entry.tags.slice(0, 1).map((tag) => <li><span class="tag">{tag}</span></li>)}
              </ul>
              <p>{entry.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </RetroWindow>
  )}

  <div class="retro-desktop">
    <RetroWindow id="about-me" title="关于我" icon="▤">
      <div class="retro-about">
        <span class="retro-about__avatar" aria-hidden="true"><span class="retro-monitor"></span></span>
        <div>
          <p>我是 {SITE.author}，目前关注语音、大模型与 vibe coding，也会把做项目时的取舍和经验写下来。</p>
          <a href="/about/">更多关于我 <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </RetroWindow>
    <RetroWindow id="shortcuts" title="快捷入口" icon="▧">
      <ul class="retro-shortcuts">
        <li><a href="/blog/">博客归档 <span aria-hidden="true">↗</span></a></li>
        <li><a href="/rss.xml">RSS 订阅 <span aria-hidden="true">↗</span></a></li>
        <li><a href={`mailto:${SITE.links.email}`}>发邮件 <span aria-hidden="true">↗</span></a></li>
      </ul>
    </RetroWindow>
  </div>
</BaseLayout>
