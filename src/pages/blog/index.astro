---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { SITE } from '../../data/site.config';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFmt = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout
  title="博客"
  description={`${SITE.author} 的技术笔记与文章归档。`}
>
  <h1 class="page-title">博客</h1>
  <p class="page-lead">
    工程实践、开源记录与技术笔记。共 {posts.length} 篇，按发表时间倒序排列。
  </p>

  {
    posts.length > 0 ? (
      <ol class="post-list-numbered">
        {posts.map((post, i) => (
          <li>
            <span class="post-list-number">
              {String(posts.length - i).padStart(2, '0')}
            </span>
            <div class="post-list-main">
              <h3 class="post-list-title">
                <a href={`/blog/${post.id}/`}>{post.data.title}</a>
              </h3>
              <p class="post-list-desc">{post.data.description}</p>
              <div class="post-list-meta">
                <time datetime={post.data.pubDate.toISOString()}>
                  {dateFmt.format(post.data.pubDate)}
                </time>
                {post.data.tags.map((tag) => <span class="tag">{tag}</span>)}
              </div>
            </div>
          </li>
        ))}
      </ol>
    ) : (
      <p>
        还没有文章。往 <code>src/content/blog/</code> 里放一个 Markdown 文件就会出现在这里。
      </p>
    )
  }
</BaseLayout>
