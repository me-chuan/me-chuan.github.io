---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      // 杂志目录式的「N° XX」编号：最新 = N° 01
      number: String(index + 1).padStart(2, '0'),
      newer: posts[index - 1] ?? null,
      older: posts[index + 1] ?? null,
    },
  }));
}

const { post, number, newer, older } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
const primaryTag = post.data.tags[0] ?? 'Journal';

// 封面存在时：详情页当「图版」用，同时接管社交分享卡片（og:image）
const coverFiles = import.meta.glob('../../assets/covers/*.png', {
  eager: true,
  query: '?url',
  import: 'default',
}) as Record<string, string>;
const coverSrc = coverFiles[`../../assets/covers/${post.id}.png`];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate}
  tags={post.data.tags}
  ogImage={coverSrc}
>
  <article class="prose">
    {
      coverSrc && (
        <img
          class="post-cover post-cover--hero"
          src={coverSrc}
          alt={`${post.data.title} — 封面`}
          width={1200}
          height={630}
          decoding="async"
        />
      )
    }
    <header class="post-header">
      <p class="post-kicker">
        <span class="post-kicker__number">N° {number}</span>
        <span>{primaryTag}</span>
        <span>{dateFmt.format(post.data.pubDate)}</span>
        {
          post.data.updatedDate && (
            <span>· 更新于 {dateFmt.format(post.data.updatedDate)}</span>
          )
        }
      </p>
      <h1>{post.data.title}</h1>
      <div class="post-header__meta">
        {
          post.data.tags.slice(1).map((tag) => (
            <span class="tag">{tag}</span>
          ))
        }
      </div>
    </header>

    <Content />
  </article>

  {
    (newer || older) && (
      <nav class="post-nav" aria-label="文章导航">
        {older ? (
          <a href={`/blog/${older.id}/`}>← {older.data.title}</a>
        ) : (
          <span />
        )}
        {newer && <a href={`/blog/${newer.id}/`}>{newer.data.title} →</a>}
      </nav>
    )
  }
</BaseLayout>
