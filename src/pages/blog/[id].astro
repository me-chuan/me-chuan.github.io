---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
  );

  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      newer: posts[index - 1] ?? null,
      older: posts[index + 1] ?? null,
    },
  }));
}

const { post, newer, older } = Astro.props;
const { Content } = await render(post);

const dateFmt = new Intl.DateTimeFormat('zh-CN', {
  year: 'numeric',
  month: '2-digit',
  day: '2-digit',
});
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedTime={post.data.pubDate}
  tags={post.data.tags}
>
  <article class="prose">
    <header class="post-header">
      <h1>{post.data.title}</h1>
      <div class="post-header__meta">
        <time datetime={post.data.pubDate.toISOString()}>{dateFmt.format(post.data.pubDate)}</time>
        {
          post.data.updatedDate && (
            <span>
              更新于 {dateFmt.format(post.data.updatedDate)}
            </span>
          )
        }
        {
          post.data.tags.map((tag) => (
            <span class="tag">{tag}</span>
          ))
        }
      </div>
    </header>

    <Content />
  </article>

  {
    (newer || older) && (
      <nav class="post-nav" aria-label="文章导航">
        {older ? (
          <a href={`/blog/${older.id}/`}>← {older.data.title}</a>
        ) : (
          <span />
        )}
        {newer && <a href={`/blog/${newer.id}/`}>{newer.data.title} →</a>}
      </nav>
    )
  }
</BaseLayout>
