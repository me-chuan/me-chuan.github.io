---
import { SITE } from '../data/site.config';
import { sitePath } from '../data/site-path';

const path = Astro.url.pathname;
const address = new URL(SITE.url).host + path;
const isActive = (href: `/${string}`) =>
  href === '/' ? path === sitePath('/') : path.startsWith(sitePath(href));
---

<header class="site-header">
  <div class="retro-chrome" aria-hidden="true">
    <div class="retro-chrome__tab">
      <span class="retro-chrome__lights"><i></i><i></i><i></i></span>
      <span class="retro-chrome__label">✦ {SITE.title}.dev</span>
    </div>
    <div class="retro-chrome__toolbar">
      <span>← →</span>
      <span class="retro-chrome__address">{address}</span>
    </div>
  </div>
  <div class="container site-header__inner">
    <a class="site-brand" href={sitePath('/')}>
      <span class="retro-monitor" aria-hidden="true"></span>
      <span>{SITE.title}.dev <b aria-hidden="true">&gt;_</b></span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {
        SITE.nav.map((item) => (
          <a href={sitePath(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <button class="retro-motion-toggle" data-retro-motion-toggle type="button" aria-label="暂停动态背景" aria-pressed="false" hidden>
        <span class="retro-motion-toggle__pause" aria-hidden="true">Ⅱ</span>
        <span class="retro-motion-toggle__play" aria-hidden="true">▶</span>
        背景
      </button>
      <button class="theme-toggle" type="button" id="theme-toggle" aria-label="切换主题" title="切换主题">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"></path>
        </svg>
      </button>
    </nav>
  </div>
</header>

<script>
  const KEY = 'retro-theme';

  const systemTheme = () =>
    window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';

  const stored = () => {
    const v = localStorage.getItem(KEY);
    return v === 'light' || v === 'dark' ? v : null;
  };

  const apply = (theme: string) => {
    document.documentElement.dataset.theme = theme;
    document.documentElement.dataset.themePref = stored() ?? 'auto';
  };

  // <ClientRouter /> 下模块脚本只执行一次，而 #theme-toggle 会在换页时被换成新节点。
  // 绑在节点上的监听器会随旧节点一起失效，所以这里绑在 document 上做事件委托 ——
  // document 在换页过程中始终不变，委托就一直在。
  // 用全局标记防止 HMR / 重复执行时叠加监听器。
  const flag = '__themeToggleBound';
  if (!(flag in window)) {
    (window as unknown as Record<string, unknown>)[flag] = true;

    // 三态循环：跟随系统 -> 浅色 -> 深色 -> 跟随系统
    document.addEventListener('click', (e) => {
      const target = (e.target as HTMLElement | null)?.closest?.('#theme-toggle');
      if (!target) return;

      const current = stored() ?? 'auto';
      const next =
        current === 'auto'
          ? systemTheme() === 'dark'
            ? 'light'
            : 'dark'
          : current === 'dark'
            ? 'auto'
            : 'dark';
      if (next === 'auto') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, next);
      apply(next === 'auto' ? systemTheme() : next);
    });

    // 跟随系统时，实时响应系统主题变化
    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', () => {
      if (!stored()) apply(systemTheme());
    });
  }
</script>
